{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n', 'a'])",
        "n": { ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().child('profiles').child($uid).child('nick').val()" },
        "a": { ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,24}$/)" },
        "afk": { ".validate": "newData.isBoolean()" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "pos": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['a', 'x', 'y', 'f'])",
        "a": { ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,24}$/)" },
        "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
        "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
        "f": { ".validate": "newData.isString() && newData.val().matches(/^[udlr]$/)" },
        "w": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "friends": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        "$other": {
          ".write": "auth != null && $owner !== $other && ((auth.uid === $owner && (!newData.exists() || root.child('requests').child($owner).child($other).exists())) || (auth.uid === $other && (!newData.exists() || root.child('requests').child($other).child($owner).exists())))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && $to !== $from && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['n', 't']) && root.child('friends').child($to).child($from).val() !== true",
          "n": { ".validate": "newData.isString() && newData.val() === root.child('profiles').child($from).child('nick').val()" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "nick": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z][A-Za-z0-9_]{2,15}$/) && newData.parent().parent().parent().child('nicknames').child(newData.val().toLowerCase()).val() === $uid" },
        "$other": { ".validate": false }
      }
    },
    "nicknames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.val() === auth.uid && $name.matches(/^[a-z][a-z0-9_]{2,15}$/) && !$name.matches(/^(admin|moderator|mod|server|system|eli|mara|grandpa|claude)$/) && newData.parent().parent().child('profiles').child(auth.uid).child('nick').val().toLowerCase() === $name"
      }
    }
  }
}
